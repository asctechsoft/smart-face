# ============================================================================
#  SmartFace — file .env cho PRODUCTION (VPS)
#
#  KHÔNG sửa tay file mẫu này để dùng. Trên VPS chạy:
#      bash scripts/init-prod-env.sh <ten-mien> <file-firebase-admin.json>
#  Script chép file này thành .env và TỰ ĐIỀN mọi dòng đánh dấu [TỰ ĐỘNG].
#  Sau đó chỉ còn các dòng [ĐIỀN TAY] phải tự điền bằng `nano .env`.
#
#  NODE_ENV, PORT, DATABASE_URL, REDIS_HOST/PORT, AI_SERVER_URL, WORKER_ENABLED
#  do docker-compose.prod.yml đặt và GHI ĐÈ — không khai ở đây.
#
#  Hướng dẫn đầy đủ: docs/23-huong-dan-deploy-cho-nguoi-moi.md
#  Giải thích từng biến: .env.example (bản cho môi trường phát triển)
# ============================================================================

# --- Hạ tầng -----------------------------------------------------------------
POSTGRES_USER=smartface
POSTGRES_DB=smartface
# [TỰ ĐỘNG] ⚠ Chỉ có hiệu lực LẦN ĐẦU Postgres khởi động. Đổi về sau là api
#            mất kết nối DB — đừng sửa.
POSTGRES_PASSWORD=
# [TỰ ĐỘNG]
REDIS_PASSWORD=
# [TỰ ĐỘNG] Khoá Backend dùng để gọi AI Server. Compose đưa cùng giá trị này
#            cho cả hai bên nên chúng không bao giờ lệch nhau.
AI_SERVER_INTERNAL_KEY=

# --- Tên miền ----------------------------------------------------------------
# [TỰ ĐỘNG] từ tham số <ten-mien>, dạng https://<ten-mien>
CORS_ORIGINS=
WEB_BASE_URL=

# --- JWT — phiên đăng nhập do Backend cấp (bắt buộc RS256) --------------------
JWT_ALGORITHM=RS256
# [TỰ ĐỘNG] Cặp khoá sinh mới. Lộ khoá riêng = ai cũng giả được phiên của bất
#            kỳ ai; mất khoá = mọi người bị đăng xuất.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
JWT_ISSUER=smartface

# --- Firebase Admin (đăng nhập + lưu ảnh) -------------------------------------
# [TỰ ĐỘNG] từ file JSON service account.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_FRESH_AUTH_WINDOW_SECONDS=300

# [ĐIỀN TAY — kiểm tra] Tên bucket ở Firebase Console → Storage, dòng gs://… phía
# trên danh sách file (bỏ phần gs://). Bỏ trống = <project-id>.firebasestorage.app,
# chỉ đúng với dự án tạo từ 10/2024; dự án cũ hơn là <project-id>.appspot.com.
FIREBASE_STORAGE_BUCKET=
STORAGE_PRESIGN_TTL_SECONDS=300

# --- Firebase Web app (nhúng vào giao diện web lúc build) ---------------------
# [ĐIỀN TAY] Firebase Console → ⚙ Project settings → General → Your apps → Web app
#            → SDK setup and configuration → Config. `apiKey` KHÔNG phải bí mật.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
# [TỰ ĐỘNG] <project-id>.firebaseapp.com — chỉ sửa nếu dùng tên miền đăng nhập riêng.
VITE_FIREBASE_AUTH_DOMAIN=
# [TUỲ CHỌN] Bản đồ ở màn chi tiết chấm công. Trống = hiện link ra Google Maps.
VITE_GOOGLE_MAPS_API_KEY=
# [TUỲ CHỌN] Đích của mục "Trợ giúp". Trống = ẩn mục đó.
VITE_HELP_URL=

# --- SMS gửi mã OTP ----------------------------------------------------------
# [ĐIỀN TAY khi có nhà cung cấp] `console` = mã OTP chỉ được in ra log của api,
# người dùng KHÔNG nhận được tin nhắn nào. Hỗ trợ: console | esms
SMS_PROVIDER=console
SMS_API_URL=
SMS_API_KEY=
SMS_SECRET_KEY=
SMS_BRAND_NAME=SmartFace

FCM_SERVER_KEY=

# --- Cố định cho production — KHÔNG sửa nếu chưa đọc docs/23 -----------------
API_PREFIX=v1
APP_NAME=SmartFace
SYSTEM_ADMIN_DOMAIN=system

# Số proxy đứng trước Backend: Cloudflare + nginx = 2. Đúng chỉ khi mọi request
# đi qua Cloudflare — nginx/cloudflare-only.conf đảm bảo điều đó.
TRUSTED_PROXY_HOPS=2

SWAGGER_ENABLED=false
REDIS_ENABLED=true
REDIS_DB=0
RATE_LIMIT_ENABLED=true

OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_LOCK_SECONDS=900
OTP_RESEND_AFTER_SECONDS=60
OTP_MAX_SEND_PER_HOUR=5
OTP_DEBUG_RETURN=false

ATTENDANCE_NONCE_TTL_SECONDS=60
# ⚠ App mobile PHẢI đã ký HMAC khi chấm công, nếu không mọi lượt chấm công bị từ
#   chối. Backend từ chối khởi động nếu đặt false ở production.
ATTENDANCE_SIGNATURE_REQUIRED=true
CLOCK_SKEW_TOLERANCE_SECONDS=120
REQUEST_TIMESTAMP_TOLERANCE_SECONDS=120

AI_SERVER_TIMEOUT_MS=2000
AI_CIRCUIT_FAILURE_THRESHOLD=5
AI_CIRCUIT_OPEN_MS=30000
