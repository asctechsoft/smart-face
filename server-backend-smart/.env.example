# ============================================================================
#  SmartFace Backend Core — biến môi trường
#  NFR-MAINT-05: không hard-code URL / secret / ngưỡng vào mã nguồn
# ============================================================================

# --- Ứng dụng ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
API_PREFIX=v1
APP_NAME=SmartFace

# Tên miền quy ước cho quản trị viên nền tảng ở màn hình đăng nhập.
# Họ không thuộc công ty nào nên không có tên miền thật để gõ.
# ⚠ Không được trùng tên miền của khách hàng thật — trùng thì khách hàng đó
#   vĩnh viễn không đăng nhập được. `createTenant` đã chặn nhưng dữ liệu cũ thì không.
SYSTEM_ADMIN_DOMAIN=system

# AF-02b — SỐ PROXY đứng TRƯỚC Backend (Nginx, Kong, ALB, Cloudflare…).
#
# Quyết định `request.ip` là địa chỉ nào, và chốt "chỉ chấm công từ mạng văn
# phòng" phụ thuộc HOÀN TOÀN vào con số này.
#
#   Chạy thẳng, không proxy      → 0
#   Sau một Nginx                → 1
#   Sau Cloudflare rồi Nginx     → 2
#
# ⚠ Khai THIẾU  → request.ip là IP của proxy, cả công ty không chấm công được.
# ⚠ Khai THỪA   → lấy nhầm mục do client tự thêm vào X-Forwarded-For,
#                 ai cũng giả mạo được IP văn phòng.
#
# Production bắt buộc khai tường minh, kể cả khi là 0.
TRUSTED_PROXY_HOPS=0
# Danh sách origin cho CORS, ngăn cách bằng dấu phẩy
CORS_ORIGINS=http://localhost:5173,http://localhost:3001
SWAGGER_ENABLED=true

# --- Database (PostgreSQL 16) ----------------------------------------------
DATABASE_URL=postgresql://smartface:smartface@localhost:5432/smartface?schema=public

# --- Redis (OTP, nonce, cache, BullMQ) --------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- Firebase Authentication (nhà cung cấp danh tính) -----------------------
#
# Firebase giữ email + mật khẩu; Backend KHÔNG lưu mật khẩu dưới bất kỳ dạng nào.
# Ba biến dưới đây lấy từ tệp JSON của service account:
#   Firebase Console → ⚙ Project settings → Service accounts → Generate new private key
#
# ⚠ FIREBASE_PRIVATE_KEY nằm trên MỘT dòng, giữ nguyên các ký tự "\n" như trong
#   tệp JSON và bọc trong dấu nháy kép. Ứng dụng tự khôi phục lại xuống dòng.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Số giây tối đa kể từ lần người dùng thực sự nhập lại mật khẩu để một ID token
# còn được coi là "vừa xác thực". Dùng cho đổi mật khẩu, tắt 2FA, xác thực lại.
FIREBASE_FRESH_AUTH_WINDOW_SECONDS=300

# --- CHỈ DEV: Firebase Auth Emulator -----------------------------------------
#
# Trỏ SDK về emulator để phát triển và seed mà không đụng dự án thật:
#   firebase emulators:start --only auth
#
# ⚠ Emulator KHÔNG kiểm chữ ký ID token — ai cũng tự dựng được token hợp lệ.
#   Ứng dụng sẽ TỪ CHỐI KHỞI ĐỘNG nếu biến này được đặt khi NODE_ENV=production.
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# --- JWT (phiên làm việc do Backend cấp) ------------------------------------
# Backend vẫn cấp access/refresh token riêng thay vì dùng thẳng Firebase ID
# token — lý do đầy đủ ở đầu file src/modules/auth/auth.service.ts.
#
# NFR-SEC-03: khuyến nghị RS256/ES256. Nếu để trống 2 biến KEY dưới đây,
# hệ thống sẽ fallback về HS256 với JWT_SECRET (CHỈ dùng cho môi trường local).
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_SECRET=dev-only-change-me
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
JWT_ISSUER=smartface

# --- OTP (xác thực 2 lớp) ---------------------------------------------------
# Lớp thứ hai do Backend tự điều phối và gửi qua SMS_PROVIDER bên dưới.
#
# Không dùng MFA của Firebase vì nó đòi nâng cấp Identity Platform (tính tiền
# theo MAU), và từ 09/2024 mọi tin nhắn của Firebase Phone Auth đòi gói Blaze có
# gắn thanh toán. Đổi lại, mọi ngưỡng chống lạm dụng dưới đây nằm trong tay mình.
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_LOCK_SECONDS=900
OTP_RESEND_AFTER_SECONDS=60
OTP_MAX_SEND_PER_HOUR=5
# Bật để trả OTP trong response (CHỈ dev, KHÔNG bật ở production)
OTP_DEBUG_RETURN=true

# --- Chấm công / bảo mật endpoint -------------------------------------------
ATTENDANCE_NONCE_TTL_SECONDS=60

# AF-12 — lớp DUY NHẤT chặn được kẻ đã đánh cắp access token.
#
# Tắt = ai lấy được token đều chấm công thay người khác được, vì mọi chốt còn
# lại đều qua: JWT hợp lệ, X-Device-Id đọc ngay từ payload token. Chỉ chữ ký mới
# cản, vì nó cần deviceSecret nằm trong secure enclave và không đi kèm token.
#
# ⚠ NODE_ENV=production mà để false thì Backend TỪ CHỐI KHỞI ĐỘNG.
#   Chỉ tắt được ở dev, giai đoạn App chưa triển khai ký HMAC.
ATTENDANCE_SIGNATURE_REQUIRED=false
CLOCK_SKEW_TOLERANCE_SECONDS=120
REQUEST_TIMESTAMP_TOLERANCE_SECONDS=120

# --- AI Server (nội bộ, KHÔNG expose ra internet) ---------------------------
AI_SERVER_URL=http://localhost:8000
AI_SERVER_INTERNAL_KEY=change-me-internal-key
AI_SERVER_TIMEOUT_MS=2000
AI_CIRCUIT_FAILURE_THRESHOLD=5
AI_CIRCUIT_OPEN_MS=30000

# --- Object storage (S3 / MinIO) --------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-southeast-1
S3_BUCKET=smartface
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_TTL_SECONDS=300

# --- SMS Gateway ------------------------------------------------------------
SMS_PROVIDER=console
SMS_API_URL=
SMS_API_KEY=
SMS_SECRET_KEY=
SMS_BRAND_NAME=SmartFace

# --- Push notification (FCM) ------------------------------------------------
FCM_SERVER_KEY=

# --- Rate limit (AF-13) -----------------------------------------------------
RATE_LIMIT_ENABLED=true

# --- Worker -----------------------------------------------------------------
# true: process này chạy các BullMQ processor. Đặt false cho pod API thuần.
WORKER_ENABLED=true
