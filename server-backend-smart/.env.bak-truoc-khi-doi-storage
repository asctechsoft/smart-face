# --- JWT --------------------------------------------------------------------
# Dev: để trống cặp khoá → fallback HS256. Production BẮT BUỘC RS256/ES256.
#
# ⚠ JWT_SECRET dưới đây KHÔNG dùng được ở production: env.validation.ts chặn
#   khởi động khi NODE_ENV=production mà thiếu JWT_PRIVATE_KEY/JWT_PUBLIC_KEY.
#   Khi lên production, sinh cặp khoá RIÊNG (đừng tái dùng khoá đã từng lộ):
#
#     openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
#     openssl rsa -in private.pem -pubout -out public.pem
#
#   Rồi nạp vào 2 biến dưới, mỗi khoá một dòng, xuống dòng viết thành \n
#   (configuration.ts tự đổi \n thành xuống dòng thật).
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_SECRET=II9uvZ67VptD8U3gh7I2YVD4HvrBPfPZjLv1MHKUXSwWmxAvz9LLbAE_aLzKe1vShnBWy9a65X5BApujjauKPA
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
JWT_ISSUER=smartface

# --- OTP --------------------------------------------------------------------
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_LOCK_SECONDS=900
OTP_RESEND_AFTER_SECONDS=60
OTP_MAX_SEND_PER_HOUR=5
OTP_DEBUG_RETURN=true

# --- Chấm công / bảo mật endpoint -------------------------------------------
ATTENDANCE_NONCE_TTL_SECONDS=60
# AF-12: chỉ được tắt ở dev khi App chưa ký HMAC. Production bật = bắt buộc.
ATTENDANCE_SIGNATURE_REQUIRED=false
CLOCK_SKEW_TOLERANCE_SECONDS=120
REQUEST_TIMESTAMP_TOLERANCE_SECONDS=120

# --- AI Server (nội bộ, KHÔNG expose ra internet) ---------------------------
