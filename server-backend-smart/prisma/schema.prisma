// ============================================================================
//  SmartFace — Prisma schema
//  Nguồn: docs/07-mo-hinh-du-lieu.md
//  PostgreSQL 16 · Multi-tenant shared schema + companyId (ADR-05)
//
//  Nguyên tắc:
//    D1 Tách bản ghi THÔ (AttendanceLog) và ĐÃ TÍNH (AttendanceDaily) — ADR-08
//    D2 Mọi bảng nghiệp vụ có companyId + index                        — BR-09
//    D3 Khoá chính CUID, không dùng số tự tăng
//    D4 Không xoá cứng dữ liệu nghiệp vụ — dùng deletedAt
//    D5 Lưu thời gian UTC (timestamptz), quy đổi theo timezone công ty
//    D6 Cấu hình chính sách có hiệu lực theo thời gian
//    D7 Bảng lớn thiết kế sẵn cho partition theo tháng
//    D8 Embedding khuôn mặt tách bảng riêng
// ============================================================================

generator client {
  provider = "prisma-client-js"
  // Bật khi hạ tầng đã cài pgvector (chỉ cần cho so khớp 1:N — kiosk):
  // previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Bật cùng previewFeatures ở trên khi dùng pgvector:
  // extensions = [vector]
}

// ============================================================================
//  1. TỔ CHỨC (TENANT)
// ============================================================================

enum CompanyStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  TERMINATED
}

model Company {
  id            String            @id @default(cuid())
  /// Mã công ty rút gọn, dùng sinh employee code. BẤT BIẾN. VD: "amobi"
  code          String            @unique
  /// Tên miền nhân viên gõ ở màn hình đăng nhập. VD: "amobi.vn" hoặc "amobi".
  ///
  /// Tách khỏi `code` vì hai thứ phục vụ hai mục đích khác nhau: `code` đi vào
  /// mã nhân viên nên BẤT BIẾN sau lần chấm công đầu (BR-04), còn tên miền là
  /// thứ đối mặt người dùng và công ty có thể muốn đổi khi đổi thương hiệu.
  domain        String            @unique
  name          String
  taxCode       String?
  timezone      String            @default("Asia/Ho_Chi_Minh")
  status        CompanyStatus     @default(TRIAL)
  planId        String?
  plan          SubscriptionPlan? @relation(fields: [planId], references: [id])
  trialEndsAt   DateTime?
  suspendedAt   DateTime?
  suspendReason String?

  branches       Branch[]
  departments    Department[]
  employees      Employee[]
  userAccounts   UserAccount[]
  policies       CompanyPolicy[]
  shifts         Shift[]
  shiftSchedules ShiftSchedule[]
  holidays       Holiday[]
  requestTypes   RequestType[]
  payrollPeriods PayrollPeriod[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status])
  @@map("company")
}

model SubscriptionPlan {
  id                      String   @id @default(cuid())
  /// "Trial" | "Basic" | "Pro" | "Enterprise"
  name                    String   @unique
  maxEmployees            Int?
  maxBranches             Int?
  maxRecognitionsPerMonth Int?
  storageGb               Int?
  photoRetentionDays      Int      @default(90)
  /// { rotatingShift: true, ot: true, multiBranch: false, ... }
  features                Json     @default("{}")
  pricePerMonth           Decimal? @db.Decimal(12, 2)
  isActive                Boolean  @default(true)

  companies Company[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subscription_plan")
}

model Branch {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  name         String
  address      String?
  /// Geofence (FR-WEB-POL-09)
  latitude     Float?
  longitude    Float?
  radiusMeters Int      @default(100)
  /// Xác thực lớp 2 tại chỗ (AF-02)
  ///
  /// `wifiSsids` CHỈ để hiển thị cho HR biết mình đang khai bộ phát nào — nó
  /// không tham gia vào quyết định. Tên mạng ai cũng đặt trùng được trong ba
  /// giây; chỉ `wifiBssids` (địa chỉ MAC của bộ phát) mới dùng để đối chiếu.
  wifiSsids    String[] @default([])
  wifiBssids   String[] @default([])
  beaconUuids  String[] @default([])

  /// AF-02b — dải IP công cộng của mạng văn phòng, dạng CIDR.
  ///
  /// VD: ["203.0.113.0/24", "198.51.100.7/32"]
  ///
  /// Đây là lớp phòng thủ MẠNH HƠN HẲN `wifiBssids`: địa chỉ nguồn do server
  /// quan sát từ kết nối TCP, client không tự khai được. BSSID thì App khai,
  /// và app đã bị sửa khai được bất cứ thứ gì.
  ///
  /// ⚠ Phải là IP CÔNG CỘNG mà nhà mạng cấp cho văn phòng, KHÔNG phải dải nội
  /// bộ sau NAT. Khai "192.168.1.0/24" là nhầm lẫn phổ biến nhất — server không
  /// bao giờ nhìn thấy địa chỉ đó.
  ///
  /// ⚠ Chốt này chỉ đúng khi `TRUSTED_PROXY_HOPS` khai đúng số proxy đứng trước
  /// Backend. Xem `configuration.ts`.
  allowedIpCidrs String[] @default([])
  /// Ghi đè timezone công ty nếu chi nhánh khác múi giờ
  timezone       String?

  departments Department[]
  employees   Employee[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([companyId])
  @@map("branch")
}

model Department {
  id        String       @id @default(cuid())
  companyId String
  company   Company      @relation(fields: [companyId], references: [id])
  branchId  String?
  branch    Branch?      @relation(fields: [branchId], references: [id])
  name      String
  /// Cây phòng ban
  parentId  String?
  parent    Department?  @relation("DeptTree", fields: [parentId], references: [id])
  children  Department[] @relation("DeptTree")
  /// Trưởng phòng — dùng cho luồng duyệt đơn (DIRECT_MANAGER)
  managerId String?

  employees Employee[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([companyId])
  @@index([companyId, branchId])
  @@map("department")
}

// Model InviteCode đã bị xoá.
//
// Nhân viên không tự tham gia công ty bằng mã mời nữa. HR cấp sẵn tài khoản
// (tên miền + email + mật khẩu tạm), nhân viên đăng nhập rồi bắt buộc đổi mật
// khẩu. Một đường vào duy nhất thì ít trường hợp biên và ít lỗ hổng hơn hai.

// ============================================================================
//  2. TÀI KHOẢN & NHÂN VIÊN
// ============================================================================

enum EmployeeStatus {
  PENDING_ACTIVATION
  ACTIVE
  SUSPENDED
  TERMINATED
}

enum SystemRole {
  SYSTEM_ADMIN
  COMPANY_ADMIN
  MANAGER
  HR_PAYROLL
  EMPLOYEE
}

/// Một số điện thoại = một tài khoản. Có thể thuộc NHIỀU công ty qua nhiều Employee.
/// Tài khoản đăng nhập.
///
/// Tài khoản gắn với ĐÚNG MỘT công ty. Một người làm ở hai công ty trên nền
/// tảng sẽ có hai tài khoản riêng, hai mật khẩu riêng — nhất quán với việc tài
/// khoản do công ty cấp: công ty A không được biết nhân viên còn làm ở đâu, và
/// mật khẩu do A cấp không được mở dữ liệu của B.
///
/// `companyId = null` dành riêng cho quản trị viên nền tảng (Web Admin), những
/// người không thuộc công ty nào.
model UserAccount {
  id        String   @id @default(cuid())
  /// null = quản trị viên nền tảng
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  /// Định danh đăng nhập, LUÔN lưu ở dạng chữ thường
  email     String
  phone     String?
  fullName  String
  avatarUrl String?
  locale    String  @default("vi")

  /// Tài khoản tương ứng bên Firebase Authentication — nơi giữ mật khẩu.
  ///
  /// Backend KHÔNG lưu mật khẩu dưới bất kỳ dạng nào nữa. Đây là mối nối duy
  /// nhất giữa danh tính (Firebase) và dữ liệu nghiệp vụ (bảng này).
  ///
  /// ⚠ HỆ QUẢ CỦA VIỆC DÙNG FIREBASE — đọc trước khi sửa `@@unique` bên dưới.
  ///
  /// Một dự án Firebase (không nâng cấp Identity Platform) coi EMAIL LÀ DUY NHẤT
  /// TOÀN DỰ ÁN. Trong khi bảng này vẫn cho phép cùng một email tồn tại ở hai
  /// công ty khác nhau (`@@unique([companyId, email])`).
  ///
  /// Nghĩa là ràng buộc chặt hơn giờ nằm ở Firebase chứ không ở đây: HR của công
  /// ty B cấp tài khoản cho một email đã dùng ở công ty A sẽ nhận `EMP_EMAIL_TAKEN`.
  /// Ràng buộc trong schema được giữ nguyên để không phải sửa dữ liệu cũ, nhưng
  /// đừng trông vào nó — Firebase mới là nơi chặn thật.
  ///
  /// Muốn khôi phục hành vi "một email dùng được ở nhiều công ty": nâng lên
  /// Identity Platform rồi ánh xạ mỗi công ty thành một Firebase tenant.
  firebaseUid String @unique

  /// true khi HR vừa cấp tài khoản. Chặn mọi API nghiệp vụ tới khi đổi mật khẩu.
  ///
  /// Vẫn do Backend giữ chứ không đẩy sang Firebase: đây là quy tắc nghiệp vụ
  /// (mật khẩu tạm đi qua nhiều tay) chứ không phải trạng thái xác thực, và
  /// `PasswordChangeGuard` phải đọc được nó ở mọi request mà không gọi Firebase.
  mustChangePassword Boolean   @default(true)
  passwordChangedAt  DateTime?

  /// Xác thực 2 lớp bằng OTP gửi qua SMS. Người dùng tự bật.
  ///
  /// Không dùng TOTP (ứng dụng xác thực) nữa, cũng không dùng MFA của Firebase —
  /// MFA đó đòi nâng cấp Identity Platform. Backend tự điều phối thử thách bằng
  /// `OtpService`, xem `AuthService`.
  twoFactorEnabled       Boolean   @default(false)
  /// Số nhận OTP, đã xác minh ở bước bật. Tách khỏi `phone` có chủ đích:
  /// đổi số liên lạc trong hồ sơ nhân sự KHÔNG được âm thầm chuyển hướng OTP.
  twoFactorPhone         String?
  twoFactorConfirmedAt   DateTime?
  /// Mã dự phòng đã băm — dùng khi mất điện thoại
  twoFactorRecoveryCodes String[]  @default([])

  isSystemAdmin Boolean   @default(false)
  isBlocked     Boolean   @default(false)
  blockedReason String?
  lastLoginAt   DateTime?

  employees     Employee[]
  refreshTokens RefreshToken[]
  devices       DeviceBinding[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  /// Email duy nhất TRONG TỪNG công ty, không phải toàn hệ thống.
  ///
  /// ⚠ Ràng buộc này KHÔNG áp dụng cho quản trị viên nền tảng: Postgres coi mọi
  /// NULL là khác nhau nên (null, 'a@b.vn') lặp lại bao nhiêu lần cũng lọt.
  /// Chỗ đó cần chỉ mục một phần, xem prisma/sql/02_auth_constraints.sql.
  @@unique([companyId, email])
  @@index([companyId])
  @@map("user_account")
}

model Employee {
  id                   String         @id @default(cuid())
  companyId            String
  company              Company        @relation(fields: [companyId], references: [id])
  /// Tài khoản đăng nhập. `null` chỉ trong khoảnh khắc HR vừa nhập hồ sơ mà
  /// chưa cấp tài khoản; bình thường luôn có.
  ///
  /// Quan hệ 1–1: tài khoản gắn với đúng một công ty nên cũng gắn với đúng một
  /// hồ sơ nhân viên.
  userId               String?        @unique
  user                 UserAccount?   @relation(fields: [userId], references: [id])
  /// Mã hiển thị: ducnv.amobi — DUY NHẤT trong công ty, BẤT BIẾN sau khi chấm công (BR-04)
  employeeCode         String
  fullName             String
  phone                String
  email                String?
  branchId             String?
  branch               Branch?        @relation(fields: [branchId], references: [id])
  departmentId         String?
  department           Department?    @relation(fields: [departmentId], references: [id])
  position             String?
  /// "Chính thức" | "Thử việc" | "Thời vụ" | "Part-time"
  contractType         String?
  joinedAt             DateTime?
  terminatedAt         DateTime?
  status               EmployeeStatus @default(PENDING_ACTIVATION)
  roles                SystemRole[]   @default([EMPLOYEE])
  /// Phạm vi quản lý — dùng cho ScopeGuard của vai trò MANAGER
  managedDepartmentIds String[]       @default([])
  /// true sau lần chấm công đầu tiên → khoá employeeCode (BR-04)
  codeLocked           Boolean        @default(false)

  faceProfiles      FaceProfile[]
  biometricKeys     BiometricKey[]
  attendanceLogs    AttendanceLog[]
  attendanceDailies AttendanceDaily[]
  requests          LeaveRequest[]
  leaveBalances     LeaveBalance[]
  shiftAssignments  ShiftAssignment[]
  makeupRecords     MakeupWorkRecord[]
  scheduleMembers   ShiftScheduleMember[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([companyId, employeeCode])
  @@unique([companyId, phone])
  @@index([companyId, status])
  @@index([companyId, departmentId])
  // Không cần @@index([userId]) — @unique ở trên đã tạo chỉ mục cho cột này.
  @@map("employee")
}

model RefreshToken {
  id            String      @id @default(cuid())
  userId        String
  user          UserAccount @relation(fields: [userId], references: [id])
  tokenHash     String      @unique
  deviceId      String
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason String?
  /// Rotation: token thay thế token này (AF-16)
  replacedById  String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_token")
}

// ============================================================================
//  3. SINH TRẮC HỌC & THIẾT BỊ
// ============================================================================

enum FaceProfileStatus {
  ACTIVE
  REPLACED
  REVOKED
}

/// Một nhân viên có NHIỀU embedding (nhiều góc, nhiều điều kiện ánh sáng).
/// D8: bảng riêng, quyền truy cập hạn chế.
model FaceProfile {
  id         String   @id @default(cuid())
  companyId  String
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  /// Vector 512 chiều đã L2-normalize, lưu dạng bytes (Float32 little-endian).
  /// Dùng được kể cả khi hạ tầng chưa bật pgvector.
  embeddingRaw Bytes?
  embeddingDim Int    @default(512)
  /// Khi bật pgvector cho so khớp 1:N (kiosk), thêm cột dưới đây bằng raw SQL migration:
  ///   ALTER TABLE face_profile ADD COLUMN embedding vector(512);
  ///   CREATE INDEX ON face_profile USING hnsw (embedding vector_cosine_ops);
  /// và khai báo: embedding Unsupported("vector(512)")?

  /// "buffalo_l@2.1" — đổi model phải re-enroll
  modelVersion  String
  qualityScore  Float?
  /// S3 key ảnh hồ sơ gốc
  photoKey      String?
  /// "FRONT" | "LEFT" | "RIGHT"
  angle         String?
  status        FaceProfileStatus @default(ACTIVE)
  enrolledAt    DateTime          @default(now())
  revokedAt     DateTime?
  revokedBy     String?
  revokedReason String?

  @@index([companyId, employeeId, status])
  @@index([modelVersion])
  @@map("face_profile")
}

/// Vân tay: server CHỈ lưu public key. Private key nằm trong secure enclave (BR-05, NFR-SEC-07)
model BiometricKey {
  id            String    @id @default(cuid())
  companyId     String
  employeeId    String
  employee      Employee  @relation(fields: [employeeId], references: [id])
  deviceId      String
  publicKey     String    @db.Text
  algorithm     String    @default("ES256")
  /// Kết quả App Attest / Play Integrity lúc đăng ký
  attestation   Json?
  revokedAt     DateTime?
  revokedReason String?

  createdAt DateTime @default(now())

  @@unique([employeeId, deviceId])
  @@index([companyId, employeeId])
  @@map("biometric_key")
}

model DeviceBinding {
  id               String      @id @default(cuid())
  companyId        String?
  userId           String
  user             UserAccount @relation(fields: [userId], references: [id])
  deviceId         String
  deviceModel      String?
  osName           String?
  osVersion        String?
  appVersion       String?
  /// Secret dùng ký HMAC request (AF-12). LƯU DẠNG HASH.
  deviceSecretHash String
  pushToken        String?
  isRooted         Boolean     @default(false)
  lastSeenAt       DateTime?
  isActive         Boolean     @default(true)
  revokedAt        DateTime?
  revokedBy        String?
  revokedReason    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, deviceId])
  @@index([companyId, userId, isActive])
  @@map("device_binding")
}

// ============================================================================
//  4. CA LÀM VIỆC & CHÍNH SÁCH
// ============================================================================

enum ShiftType {
  /// Ca hành chính
  FIXED
  /// Ca xoay / ca kíp
  ROTATING
  /// Ca linh hoạt theo tổng giờ
  FLEXIBLE
}

model Shift {
  id                         String    @id @default(cuid())
  companyId                  String
  company                    Company   @relation(fields: [companyId], references: [id])
  /// "Hành chính", "Ca đêm"
  name                       String
  type                       ShiftType @default(FIXED)
  /// Giờ dạng "HH:mm" theo timezone công ty
  startTime                  String?
  endTime                    String?
  /// true nếu ca kết thúc vào NGÀY HÔM SAU (ca đêm 22:00 → 06:00)
  crossesMidnight            Boolean   @default(false)
  breakMinutes               Int       @default(0)
  /// Ca linh hoạt: tổng phút phải làm trong ngày
  requiredMinutes            Int?
  lateToleranceMinutes       Int       @default(0)
  earlyLeaveToleranceMinutes Int       @default(0)
  /// Ca mặc định của công ty khi nhân viên không được phân ca (BR-ATT-04)
  isDefault                  Boolean   @default(false)
  /// Bitmask ngày trong tuần áp dụng: 1=T2 ... 64=CN. 0 = mọi ngày
  weekdayMask                Int       @default(0)
  /// Hiệu lực theo thời gian (D6) — đổi giờ ca giữa tháng không phá dữ liệu cũ
  effectiveFrom              DateTime
  effectiveTo                DateTime?

  // ---------------------------------------------------------------------------
  //  Danh mục ca (FR-WEB-POL-04)
  // ---------------------------------------------------------------------------

  /// Mã ca do công ty tự đặt — "HC", "C1", "D2". Duy nhất trong một công ty.
  code   String
  /// Ký hiệu in trên bảng chấm công — "X", "+", "Đ". Không cần duy nhất:
  /// nhiều ca khác nhau vẫn có thể cùng hiện một ký hiệu trên bảng công.
  symbol String?

  /// Phòng ban áp dụng. Rỗng = mọi phòng ban.
  ///
  /// Chỉ dùng để LỌC GỢI Ý khi phân ca, không chặn. Ràng buộc cứng ở đây sẽ
  /// biến mọi ngoại lệ có thật — mượn việc sang phòng khác, ca đặc biệt cuối
  /// năm — thành một lần phải vào sửa danh mục trước khi xếp được lịch.
  departmentIds String[] @default([])

  /// BR-ATT-02: ca nào cũng phải chấm vào, nếu không thì không có gì để tính
  /// giờ công. Cột vẫn tồn tại để đọc lên giao diện, nhưng service từ chối
  /// mọi yêu cầu đặt về `false`.
  requireCheckIn  Boolean @default(true)
  /// Khung giờ chấm vào được chấp nhận, dạng "HH:mm". Null = không giới hạn.
  checkInFrom     String?
  checkInTo       String?
  /// Ca chỉ điểm danh đầu giờ (họp, đào tạo) thì tắt chấm ra.
  requireCheckOut Boolean @default(true)
  checkOutFrom    String?
  checkOutTo      String?

  /// Nghỉ giữa ca theo GIỜ CỤ THỂ. `breakMinutes` ở trên vẫn là nguồn duy nhất
  /// mà máy tính công đọc — hai cột này chỉ mô tả khoảng nghỉ nằm ở đâu, và
  /// service tự tính `breakMinutes` lại từ chúng để hai bên không bao giờ lệch.
  breakStart String?
  breakEnd   String?

  /// Số ngày công một ca này được tính. Ca gãy nửa buổi đặt 0.5.
  workDayCredit Decimal @default(1.00) @db.Decimal(4, 2)

  /// Hệ số ngày công theo tính chất của ngày.
  ///
  /// ⚠ CHƯA được máy tính công đọc tới — xem `docs/04` mục 6.5. Đây là khai báo
  /// danh mục, không phải cấu hình đang có hiệu lực. Đừng suy ra số liệu bảng
  /// công từ mấy cột này cho tới khi phần nối vào engine được làm.
  normalDayFactor   Decimal @default(1.00) @db.Decimal(4, 2)
  weeklyRestFactor  Decimal @default(2.00) @db.Decimal(4, 2)
  holidayFactor     Decimal @default(3.00) @db.Decimal(4, 2)

  segments       ShiftSegment[]
  assignments    ShiftAssignment[]
  holidayFactors ShiftHolidayFactor[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  /// ⚠ Ràng buộc DUY NHẤT của `code` là một PARTIAL UNIQUE INDEX, không khai
  /// được ở đây (Prisma chưa hỗ trợ `WHERE` cho `@@unique`). Nó nằm trong
  /// `migrations/20260815130000_shift_code_partial_unique`:
  ///
  ///   UNIQUE ("companyId", "code") WHERE "effectiveTo" IS NULL
  ///
  /// Phải là partial vì D6: đổi giờ một ca đã phân sẽ ĐÓNG bản hiện tại
  /// (`effectiveTo`) rồi mở bản kế nhiệm mang CÙNG mã. Ràng buộc đầy đủ sẽ chặn
  /// đúng cơ chế phiên bản hoá của chính hệ thống này.
  ///
  /// Bản đã đóng nhả mã cho bản kế nhiệm; bản xoá mềm thì KHÔNG (`effectiveTo`
  /// vẫn null) — mã ca đã in trên bảng công không được mang nghĩa khác.
  @@index([companyId, code])
  @@index([companyId, effectiveFrom])
  @@map("shift")
}

/// Hệ số ngày công đặt riêng cho MỘT ngày lễ cụ thể của MỘT ca.
///
/// Tồn tại vì `holidayFactor` chung không đủ: Tết trả khác 30/4, và cùng một
/// ngày lễ thì ca đêm lại khác ca hành chính. Không có bản ghi ở đây thì ca
/// dùng `holidayFactor` chung — bảng này chỉ chứa ngoại lệ, không chứa mặc định.
model ShiftHolidayFactor {
  id        String  @id @default(cuid())
  shiftId   String
  shift     Shift   @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  holidayId String
  holiday   Holiday @relation(fields: [holidayId], references: [id], onDelete: Cascade)
  factor    Decimal @db.Decimal(4, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shiftId, holidayId])
  @@index([holidayId])
  @@map("shift_holiday_factor")
}

/// Ca gãy: sáng 08:00-12:00, chiều 14:00-18:00
model ShiftSegment {
  id        String @id @default(cuid())
  shiftId   String
  shift     Shift  @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  order     Int
  startTime String
  endTime   String

  @@index([shiftId])
  @@map("shift_segment")
}

model ShiftAssignment {
  id         String   @id @default(cuid())
  companyId  String
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  shiftId    String
  shift      Shift    @relation(fields: [shiftId], references: [id])
  /// Ngày làm việc áp dụng (theo timezone công ty)
  workDate   DateTime @db.Date
  createdBy  String?

  /// Bảng phân ca đã sinh ra lượt này. Null = xếp ngoài bảng (dữ liệu cũ).
  ///
  /// ⚠ `@@unique([employeeId, workDate])` KHÔNG kèm `scheduleId`, và không được
  /// kèm: máy tính công đọc đúng MỘT ca cho một người trong một ngày. Cho hai
  /// bảng cùng giữ một ô là để engine chọn bừa một trong hai.
  scheduleId String?
  schedule   ShiftSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([employeeId, workDate])
  @@index([companyId, workDate])
  @@index([scheduleId])
  @@map("shift_assignment")
}

/// Bảng phân ca của một tháng — FR-WEB-HR-05.
///
/// Đây là ĐƠN VỊ CÔNG VIỆC của người xếp lịch ("bảng phân ca tháng 8 phòng
/// Kho"), đứng trên `ShiftAssignment` vốn chỉ là từng ô lịch rời rạc. Bảng giữ
/// phạm vi đã chốt lúc lập — phòng ban nào, được dùng những ca nào — để mọi
/// thao tác bên trong không đi ra ngoài phạm vi đó.
model ShiftSchedule {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  name      String

  /// Kỳ lập bảng. LUÔN là ngày 01 của tháng — service tự chuẩn hoá.
  /// Lưu ngày cụ thể thay vì cặp (năm, tháng) để so sánh khoảng và sắp xếp
  /// bằng chính kiểu dữ liệu, không phải bằng phép ghép chuỗi.
  periodMonth DateTime @db.Date

  /// Phạm vi chốt lúc lập bảng. Màn chi tiết chỉ cho lọc và phân ca trong đây.
  departmentIds String[] @default([])
  shiftIds      String[] @default([])

  createdBy String?

  members     ShiftScheduleMember[]
  assignments ShiftAssignment[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([companyId, periodMonth])
  @@map("shift_schedule")
}

/// Một CBNV có mặt trong bảng phân ca.
///
/// Tồn tại thành bảng riêng thay vì suy ra từ `departmentIds`: danh sách người
/// được CHỐT lúc lập bảng và sửa được sau đó (thêm/bớt CBNV). Suy ra động thì
/// một lần đổi phòng ban của nhân viên sẽ âm thầm viết lại một bảng đã xếp xong.
model ShiftScheduleMember {
  id         String        @id @default(cuid())
  scheduleId String
  schedule   ShiftSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  /// Bản sao của `schedule.periodMonth`, tồn tại DUY NHẤT để ràng buộc bên dưới
  /// chạy được ở tầng database. Service luôn ghi hai chỗ cùng lúc.
  periodMonth DateTime @db.Date

  createdAt DateTime @default(now())

  /// Một người, một tháng, một bảng. Không có ràng buộc này thì hai bảng cùng
  /// tháng sẽ tranh nhau ghi vào cùng ô `(employeeId, workDate)`, bảng lưu sau
  /// đè bảng lưu trước — và màn chi tiết của bảng kia hiển thị ca mà nó không
  /// hề xếp.
  @@unique([employeeId, periodMonth])
  @@unique([scheduleId, employeeId])
  @@index([scheduleId])
  @@map("shift_schedule_member")
}

model Holiday {
  id             String    @id @default(cuid())
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id])
  name           String
  date           DateTime  @db.Date
  /// Nghỉ bù khi lễ trùng cuối tuần
  substituteDate DateTime? @db.Date
  /// Hệ số OT áp dụng cho ngày này (NFR-LEGAL-05: ngày lễ ≥ 300%)
  otMultiplier   Decimal   @default(3.0) @db.Decimal(4, 2)
  /// Rỗng = áp dụng toàn công ty
  branchIds      String[]  @default([])

  shiftFactors ShiftHolidayFactor[]

  createdAt DateTime @default(now())

  @@unique([companyId, date])
  @@index([companyId, date])
  @@map("holiday")
}

/// Toàn bộ chính sách cấu hình được của công ty (BR-12).
/// Key-value có hiệu lực theo thời gian (D6).
model CompanyPolicy {
  id            String    @id @default(cuid())
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id])
  /// VD: "attendance.geofence.outOfRangeAction"
  key           String
  value         Json
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  updatedBy     String?

  createdAt DateTime @default(now())

  @@index([companyId, key, effectiveFrom])
  @@map("company_policy")
}

model LeavePolicy {
  id                   String    @id @default(cuid())
  companyId            String
  /// null = áp dụng chung cho mọi loại hợp đồng
  contractType         String?
  /// NFR-LEGAL-07: tối thiểu 12 ngày/năm
  baseDaysPerYear      Decimal   @default(12) @db.Decimal(5, 2)
  seniorityBonusDays   Decimal   @default(1) @db.Decimal(5, 2)
  seniorityEveryYears  Int       @default(5)
  allowCarryOver       Boolean   @default(true)
  maxCarryOverDays     Decimal?  @db.Decimal(5, 2)
  /// Phép cộng dồn hết hạn tháng mấy của năm sau
  carryOverExpireMonth Int?      @default(3)
  /// "YEARLY" | "MONTHLY"
  accrualMode          String    @default("YEARLY")
  effectiveFrom        DateTime  @default(now())
  effectiveTo          DateTime?

  createdAt DateTime @default(now())

  @@index([companyId, effectiveFrom])
  @@map("leave_policy")
}

model LeaveBalance {
  id              String   @id @default(cuid())
  companyId       String
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id])
  year            Int
  /// Được cấp
  entitledDays    Decimal  @db.Decimal(5, 2)
  carriedOverDays Decimal  @default(0) @db.Decimal(5, 2)
  usedDays        Decimal  @default(0) @db.Decimal(5, 2)
  /// Đang chờ duyệt
  pendingDays     Decimal  @default(0) @db.Decimal(5, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, year])
  @@index([companyId, year])
  @@map("leave_balance")
}

// ============================================================================
//  5. CHẤM CÔNG
// ============================================================================

enum AttendanceType {
  CHECK_IN
  CHECK_OUT
  BREAK_OUT
  BREAK_IN
  /// AF-20 — xác thực ngẫu nhiên giữa ca
  RANDOM_CHECK
}

enum AuthMethod {
  FACE
  FINGERPRINT
  /// Do HR/Kế toán bổ sung
  MANUAL
  KIOSK
}

enum AttendanceDecision {
  ACCEPTED
  /// Chấp nhận nhưng gắn cờ
  FLAGGED
  /// Chờ duyệt mới tính công
  PENDING_REVIEW
  REJECTED
}

/// ⚠ BẢNG THÔ — BẤT BIẾN. KHÔNG BAO GIỜ UPDATE hay DELETE (BR-06, ADR-08).
/// Mọi hiệu chỉnh tạo bản ghi AttendanceAdjustment riêng.
/// D7: chuẩn bị partition theo tháng — xem prisma/sql/02_partitioning.sql
model AttendanceLog {
  id         String         @id @default(cuid())
  companyId  String
  employeeId String
  employee   Employee       @relation(fields: [employeeId], references: [id])
  branchId   String?
  type       AttendanceType
  authMethod AuthMethod

  /// ⏰ THỜI GIAN CHÍNH THỨC — server timestamp (BR-01, AF-17)
  recordedAt       DateTime  @default(now())
  /// Giờ client gửi lên — CHỈ để đối chiếu, KHÔNG dùng tính công (AF-18)
  clientReportedAt DateTime?
  clockSkewSeconds Int?
  /// Ngày làm việc quy đổi theo timezone công ty. Ca đêm gắn với NGÀY BẮT ĐẦU CA.
  workDate         DateTime  @db.Date

  /// --- Vị trí (AF-01..AF-04) ---
  latitude          Float?
  longitude         Float?
  gpsAccuracy       Float?
  /// "gps" | "network" | "fused" | "mock"
  locationProvider  String?
  isMockLocation    Boolean  @default(false)
  distanceToBranchM Float?
  insideGeofence    Boolean?
  wifiBssid         String?
  beaconUuid        String?

  /// --- Thiết bị & mạng ---
  deviceId          String?
  deviceModel       String?
  osVersion         String?
  appVersion        String?
  isRootedDevice    Boolean  @default(false)
  attestationPassed Boolean?
  ipAddress         String?

  /// --- Kết quả AI (AI Server trả số liệu, Backend quyết định — P3) ---
  matchScore        Float?
  livenessScore     Float?
  /// { blur, brightness, yaw, facePx }
  imageQuality      Json?
  /// "BLINK" | "TURN_LEFT" | ...
  livenessChallenge String?
  aiModelVersion    String?
  aiProcessingMs    Int?

  /// --- Bằng chứng ---
  photoKey  String?
  photoHash String?

  /// --- Đánh giá rủi ro (mục 7 của 06-anti-fraud.md) ---
  fraudScore Int                @default(0)
  decision   AttendanceDecision @default(ACCEPTED)

  /// --- Nguồn ---
  isOffline       Boolean @default(false)
  /// Khi authMethod = MANUAL
  createdByUserId String?

  fraudFlags  FraudFlag[]
  adjustments AttendanceAdjustment[]

  createdAt DateTime @default(now())

  @@index([companyId, employeeId, workDate])
  @@index([companyId, workDate])
  @@index([companyId, decision])
  @@index([employeeId, recordedAt])
  @@map("attendance_log")
}

model FraudFlag {
  id              String         @id @default(cuid())
  companyId       String
  attendanceLogId String?
  attendanceLog   AttendanceLog? @relation(fields: [attendanceLogId], references: [id])
  employeeId      String
  /// MOCK_LOCATION | ROOTED_DEVICE | CLOCK_TAMPERING | IMPOSSIBLE_TRAVEL |
  /// MULTI_DEVICE_ANOMALY | OUT_OF_GEOFENCE | LOW_LIVENESS | SHORT_ATTENDANCE | ...
  code            String
  /// "LOW" | "MEDIUM" | "HIGH"
  severity        String
  score           Int
  details         Json?
  /// Xử lý (AF-23)
  reviewedBy      String?
  reviewedAt      DateTime?
  /// "KEEP" | "VOID" | "ESCALATE"
  reviewDecision  String?
  reviewReason    String?

  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([companyId, reviewedAt])
  @@index([attendanceLogId])
  @@index([companyId, employeeId])
  @@map("fraud_flag")
}

/// Hiệu chỉnh công thủ công — KHÔNG sửa đè AttendanceLog (BR-ADJ-01)
model AttendanceAdjustment {
  id              String         @id @default(cuid())
  companyId       String
  employeeId      String
  workDate        DateTime       @db.Date
  /// null nếu là BỔ SUNG bản ghi hoàn toàn mới (quên chấm công)
  attendanceLogId String?
  attendanceLog   AttendanceLog? @relation(fields: [attendanceLogId], references: [id])
  /// "ADD" | "MODIFY_TIME" | "VOID"
  adjustType      String
  beforeValue     Json?
  afterValue      Json?
  reason          String
  /// Đơn "Bổ sung công" liên quan (nếu có)
  requestId       String?
  createdByUserId String

  createdAt DateTime @default(now())

  @@index([companyId, employeeId, workDate])
  @@map("attendance_adjustment")
}

enum DailyStatus {
  ON_TIME
  LATE
  EARLY_LEAVE
  LATE_AND_EARLY
  OVERTIME
  INSUFFICIENT
  ON_LEAVE
  HOLIDAY
  ABSENT
  MISSING_RECORD
  WEEKEND
}

/// ✅ BẢNG ĐÃ TÍNH — tính lại được bất cứ lúc nào (ADR-08).
/// Job tính công phải IDEMPOTENT (NFR-REL-06).
model AttendanceDaily {
  id         String   @id @default(cuid())
  companyId  String
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  workDate   DateTime @db.Date
  shiftId    String?

  firstCheckInAt    DateTime?
  lastCheckOutAt    DateTime?
  workedMinutes     Int         @default(0)
  breakMinutes      Int         @default(0)
  lateMinutes       Int         @default(0)
  earlyLeaveMinutes Int         @default(0)
  otMinutes         Int         @default(0)
  otMultiplier      Decimal?    @db.Decimal(4, 2)
  makeupMinutes     Int         @default(0)
  /// Số công chuẩn quy đổi
  standardDays      Decimal     @default(0) @db.Decimal(5, 3)
  status            DailyStatus @default(ABSENT)
  /// Đơn từ ảnh hưởng ngày này
  appliedRequestIds String[]    @default([])
  hasFraudFlag      Boolean     @default(false)
  /// Truy vết: lần tính gần nhất và phiên bản engine
  calculatedAt      DateTime    @default(now())
  calcEngineVersion String?
  /// Snapshot chi tiết phục vụ giải trình "con số này ra từ đâu"
  breakdown         Json?

  @@unique([employeeId, workDate])
  @@index([companyId, workDate])
  @@index([companyId, employeeId, workDate])
  @@index([companyId, status])
  @@map("attendance_daily")
}

// ============================================================================
//  6. ĐƠN TỪ
// ============================================================================

enum RequestStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// Loại đơn cấu hình được theo công ty (không hard-code enum)
model RequestType {
  id                  String  @id @default(cuid())
  companyId           String
  company             Company @relation(fields: [companyId], references: [id])
  /// "ANNUAL_LEAVE" | "GO_OUT" | "MAKEUP" | "BUSINESS_TRIP" | "OT_REGISTER" | ...
  code                String
  name                String
  /// Trừ vào đâu: "ANNUAL_LEAVE" | "NONE" | "UNPAID" | "OT_CREDIT" | "MAKEUP_CREDIT"
  deductFrom          String  @default("NONE")
  /// "DAY" | "HALF_DAY" | "HOUR"
  unit                String  @default("DAY")
  requiresAttachment  Boolean @default(false)
  /// OT phải duyệt trước mới tính
  requiresPreApproval Boolean @default(false)
  maxDaysPerRequest   Int?
  isActive            Boolean @default(true)

  approvalFlow ApprovalFlow?
  requests     LeaveRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
  @@map("request_type")
}

model ApprovalFlow {
  id            String      @id @default(cuid())
  companyId     String
  requestTypeId String      @unique
  requestType   RequestType @relation(fields: [requestTypeId], references: [id], onDelete: Cascade)

  steps ApprovalFlowStep[]

  createdAt DateTime @default(now())

  @@map("approval_flow")
}

model ApprovalFlowStep {
  id           String       @id @default(cuid())
  flowId       String
  flow         ApprovalFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)
  order        Int
  /// "DIRECT_MANAGER" | "DEPARTMENT_HEAD" | "HR_PAYROLL" | "COMPANY_ADMIN"
  approverRole String
  isRequired   Boolean      @default(true)
  /// Điều kiện kích hoạt bước này, VD { "minDays": 3 }
  condition    Json?

  @@index([flowId, order])
  @@map("approval_flow_step")
}

model LeaveRequest {
  id            String        @id @default(cuid())
  companyId     String
  employeeId    String
  employee      Employee      @relation(fields: [employeeId], references: [id])
  requestTypeId String
  requestType   RequestType   @relation(fields: [requestTypeId], references: [id])
  status        RequestStatus @default(DRAFT)

  startAt          DateTime
  endAt            DateTime
  /// Số ngày/giờ quy đổi
  quantity         Decimal   @db.Decimal(6, 2)
  isHalfDay        Boolean   @default(false)
  reason           String    @db.Text
  /// Cho đơn "Xin ra ngoài": giờ về dự kiến
  expectedReturnAt DateTime?

  submittedAt  DateTime?
  decidedAt    DateTime?
  rejectReason String?
  cancelledAt  DateTime?
  cancelledBy  String?

  approvalSteps ApprovalStep[]
  attachments   RequestAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, status])
  @@index([companyId, employeeId, startAt])
  @@index([employeeId, status])
  @@map("leave_request")
}

model ApprovalStep {
  id            String       @id @default(cuid())
  companyId     String
  requestId     String
  request       LeaveRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  order         Int
  approverRole  String
  /// Người được phân công duyệt (giải quyết cụ thể tại thời điểm gửi đơn)
  approverId    String?
  /// "PENDING" | "APPROVED" | "REJECTED" | "SKIPPED"
  status        String       @default("PENDING")
  decidedAt     DateTime?
  comment       String?
  /// Người duyệt thay khi người duyệt chính vắng mặt (BR-APV-04)
  delegatedFrom String?

  @@index([companyId, status])
  @@index([requestId, order])
  @@index([approverId, status])
  @@map("approval_step")
}

model RequestAttachment {
  id        String       @id @default(cuid())
  companyId String
  requestId String
  request   LeaveRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  fileKey   String
  fileName  String
  mimeType  String
  sizeBytes Int

  uploadedAt DateTime @default(now())

  @@index([requestId])
  @@map("request_attachment")
}

// ============================================================================
//  7. LÀM BÙ, KỲ LƯƠNG
// ============================================================================

model MakeupWorkRecord {
  id               String    @id @default(cuid())
  companyId        String
  employeeId       String
  employee         Employee  @relation(fields: [employeeId], references: [id])
  /// Ngày phát sinh nợ công
  debtWorkDate     DateTime  @db.Date
  debtMinutes      Int
  /// Ngày thực hiện làm bù
  makeupWorkDate   DateTime? @db.Date
  makeupMinutes    Int       @default(0)
  remainingMinutes Int
  /// Hạn phải làm bù
  dueDate          DateTime? @db.Date
  requestId        String?
  /// "OPEN" | "PARTIAL" | "COMPLETED" | "EXPIRED"
  status           String    @default("OPEN")
  /// "MANUAL" (HR nhập tay) | "ENGINE" (engine tính công tự sinh từ ngày thiếu giờ)
  ///
  /// Engine CHỈ được sửa/xoá dòng của chính nó. Không có cột này thì mỗi lần
  /// tính lại một ngày, engine sẽ xoá nhầm khoản nợ HR nhập tay theo thoả thuận
  /// riêng — chỉ vì ngày đó nhìn từ bảng chấm công thì không thiếu giờ.
  source           String    @default("MANUAL")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, employeeId, status])
  @@index([companyId, employeeId, debtWorkDate])
  @@map("makeup_work_record")
}

enum PayrollPeriodStatus {
  OPEN
  REVIEWING
  CLOSED
}

model PayrollPeriod {
  id           String              @id @default(cuid())
  companyId    String
  company      Company             @relation(fields: [companyId], references: [id])
  /// "Tháng 08/2026"
  name         String
  startDate    DateTime            @db.Date
  endDate      DateTime            @db.Date
  status       PayrollPeriodStatus @default(OPEN)
  closedAt     DateTime?
  closedBy     String?
  /// Mở lại kỳ đã chốt — thao tác đặc quyền (BR-07)
  reopenedAt   DateTime?
  reopenedBy   String?
  reopenReason String?

  summaries PayrollSummary[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, startDate, endDate])
  @@index([companyId, status])
  @@map("payroll_period")
}

/// Snapshot bảng công tại thời điểm chốt kỳ — BẤT BIẾN sau khi chốt
model PayrollSummary {
  id         String        @id @default(cuid())
  companyId  String
  periodId   String
  period     PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employeeId String

  standardDays     Decimal  @db.Decimal(6, 2)
  workedMinutes    Int
  otMinutesNormal  Int      @default(0)
  otMinutesWeekend Int      @default(0)
  otMinutesHoliday Int      @default(0)
  lateCount        Int      @default(0)
  lateMinutesTotal Int      @default(0)
  earlyLeaveCount  Int      @default(0)
  leaveDays        Decimal  @default(0) @db.Decimal(5, 2)
  unpaidLeaveDays  Decimal  @default(0) @db.Decimal(5, 2)
  makeupMinutes    Int      @default(0)
  penaltyAmount    Decimal? @db.Decimal(14, 2)
  violationCount   Int      @default(0)
  /// Chi tiết để giải trình
  breakdown        Json?

  calculatedAt DateTime @default(now())

  @@unique([periodId, employeeId])
  @@index([companyId, periodId])
  @@map("payroll_summary")
}

// ============================================================================
//  8. HỆ THỐNG
// ============================================================================

model Notification {
  id           String    @id @default(cuid())
  companyId    String?
  /// Người nhận. null + companyId → thông báo toàn công ty
  employeeId   String?
  departmentId String?
  /// "REQUEST_APPROVED" | "ATTENDANCE_REMINDER" | "FRAUD_FLAGGED" | ...
  type         String
  title        String
  body         String    @db.Text
  data         Json?
  /// "PUSH" | "IN_APP" | "SMS" | "EMAIL"
  channel      String    @default("PUSH")
  scheduledAt  DateTime?
  sentAt       DateTime?
  readAt       DateTime?
  createdBy    String?

  createdAt DateTime @default(now())

  @@index([companyId, employeeId, readAt])
  @@index([scheduledAt, sentAt])
  @@map("notification")
}

/// Append-only. KHÔNG cho update/delete kể cả Admin (BR-08, NFR-SEC-10).
model AuditLog {
  id             String  @id @default(cuid())
  companyId      String?
  actorUserId    String?
  actorName      String?
  actorRole      String?
  actorIp        String?
  actorUserAgent String?
  /// "BIOMETRIC_RESET" | "PAYROLL_REOPEN" | "ATTENDANCE_ADJUST" | ...
  action         String
  targetType     String?
  targetId       String?
  reason         String?
  before         Json?
  after          Json?
  traceId        String?

  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
  @@map("audit_log")
}

/// Cấu hình toàn hệ thống (Admin) — khác CompanyPolicy (cấu hình theo công ty)
model SystemConfig {
  key         String   @id
  value       Json
  description String?
  updatedBy   String?
  updatedAt   DateTime @updatedAt
}

model AiModelVersion {
  id                       String    @id @default(cuid())
  /// "buffalo_l"
  name                     String
  /// "2.1"
  version                  String
  isActive                 Boolean   @default(false)
  /// Kết quả đo trên tập kiểm định
  farMeasured              Float?
  frrMeasured              Float?
  latencyP95Ms             Int?
  defaultMatchThreshold    Float?
  defaultLivenessThreshold Float?
  deployedAt               DateTime?
  rolledBackAt             DateTime?
  notes                    String?

  createdAt DateTime @default(now())

  @@unique([name, version])
  @@map("ai_model_version")
}

/// Theo dõi job export bất đồng bộ (202 Accepted → /v1/jobs/{id})
model ExportJob {
  id           String  @id @default(cuid())
  companyId    String
  createdBy    String
  /// "ATTENDANCE" | "PAYROLL" | "EMPLOYEE_IMPORT_RESULT" | ...
  kind         String
  /// "QUEUED" | "PROCESSING" | "DONE" | "FAILED"
  status       String  @default("QUEUED")
  params       Json?
  fileKey      String?
  fileName     String?
  errorCode    String?
  errorMessage String?
  progress     Int     @default(0)

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([companyId, createdAt])
  @@map("export_job")
}
