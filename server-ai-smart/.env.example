# AI Server — biến môi trường.
# Sao chép thành .env rồi sửa. KHÔNG commit file .env.

ENV=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# --- Bảo mật ------------------------------------------------------------------
# Phải TRÙNG với AI_SERVER_INTERNAL_KEY trong BackEnd/.env
# Production: bắt buộc, tối thiểu 32 ký tự. Sinh bằng: openssl rand -hex 32
AI_SERVER_INTERNAL_KEY=change-me-internal-key
MAX_IMAGE_BYTES=20971520

# --- Engine -------------------------------------------------------------------
# insightface = model thật | stub = dữ liệu bịa, chỉ để phát triển
ENGINE=insightface
MODEL_PACK=buffalo_l
MODEL_ROOT=./models
MODEL_VERSION_LABEL=buffalo_l@2.1

# CPU:  CPUExecutionProvider
# GPU:  CUDAExecutionProvider,CPUExecutionProvider   (cần onnxruntime-gpu)
PROVIDERS=CPUExecutionProvider

DET_SIZE=640
MAX_CONCURRENCY=4
WARMUP_ON_STARTUP=true

# --- Chống giả mạo ------------------------------------------------------------
# Chạy `python scripts/download_models.py` để tải.
LIVENESS_MODEL_PATH=./models/anti_spoof/MiniFASNetV2.onnx

# Bật cờ này = chấp nhận ảnh in ra cũng chấm công được. Production bị chặn.
ALLOW_MISSING_LIVENESS_MODEL=false

# --- Sàn kỹ thuật chất lượng ảnh ----------------------------------------------
# KHÔNG PHẢI ngưỡng nghiệp vụ. Ngưỡng nghiệp vụ (min_face_pixels,
# liveness_threshold, face_match_threshold) nằm ở Backend theo từng công ty — P3.
FLOOR_BLUR=25
FLOOR_BRIGHTNESS_DARK=35
FLOOR_BRIGHTNESS_BRIGHT=235
FLOOR_FACE_PX=48
FLOOR_DETECTION_SCORE=0.5

# --- Xác minh hành động liveness từ tư thế đầu (AF-05) ------------------------
POSE_YAW_THRESHOLD=18
POSE_PITCH_THRESHOLD=14
