# ---------------------------------------------------------------------------
#  SmartFace — Web Quản lý
#  Sao chép file này thành `.env` rồi điền giá trị thật.
#  ⚠ KHÔNG commit file `.env` (NFR-SEC-09).
# ---------------------------------------------------------------------------

# Đường dẫn gốc của Backend. Để nguyên `/v1` khi chạy dev — Vite proxy sang
# VITE_API_PROXY_TARGET nên trình duyệt coi API là cùng origin, không dính CORS.
VITE_API_BASE_URL=/v1
VITE_API_PROXY_TARGET=http://localhost:3000

# ---------------------------------------------------------------------------
#  Firebase Authentication
#
#  Danh tính do Firebase quản lý; Backend chỉ nhận ID token và KHÔNG bao giờ
#  nhận mật khẩu.
#
#  ⚠ PHẢI CÙNG DỰ ÁN với `FIREBASE_PROJECT_ID` trong server-backend-smart/.env.
#  Khác dự án thì Backend không xác minh được ID token do Web gửi lên.
#
#  Lấy ở: Firebase Console → ⚙ Project settings → General → Your apps → Web app.
#  Chưa có app nào thì bấm "Add app" → chọn Web → Register app.
#
#  `apiKey` của Firebase KHÔNG phải bí mật — nó chỉ định danh dự án, mọi quyền
#  truy cập vẫn do Backend quyết định. Vẫn để trong .env để dev/staging/production
#  dùng dự án khác nhau.
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=smartface-xxxx.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=smartface-xxxx
VITE_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
#  Tuỳ chọn
# ---------------------------------------------------------------------------

# Múi giờ dùng tạm trước khi biết `company.timezone` từ API.
VITE_DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh

# Bản đồ ở màn chi tiết chấm công. Bỏ trống → hiện link ra Google Maps thay vì
# nhúng bản đồ.
VITE_GOOGLE_MAPS_API_KEY=

# WebSocket cho thông báo realtime (đơn mới cần duyệt). Bỏ trống → dùng polling.
VITE_WS_URL=
