# ============================================================================
#  Web Quản lý (web-smart) — image production.
#
#    builder  Node build SPA ra dist/ (`tsc -b && vite build`).
#    runner   nginx phục vụ dist/ VÀ đứng trước API. Cấu hình nginx KHÔNG nằm
#             trong image mà mount từ server-backend-smart/nginx/ lúc chạy —
#             xem service `web` trong server-backend-smart/docker-compose.prod.yml.
#
#  ⚠ Vite NHÚNG các biến VITE_* vào bundle LÚC BUILD. Chúng đi vào bằng build
#    ARG, không phải biến môi trường lúc chạy: đổi giá trị thì phải build lại
#    image, restart container không có tác dụng gì.
# ============================================================================

FROM node:20-alpine AS builder
WORKDIR /app

COPY package*.json ./
RUN npm ci --no-audit --no-fund

COPY . .

# Build ARG tự thành biến môi trường cho các lệnh RUN phía sau, và Vite nhận
# mọi biến VITE_* có sẵn trong môi trường — không cần file .env nào.
ARG VITE_API_BASE_URL=/v1
ARG VITE_FIREBASE_API_KEY
ARG VITE_FIREBASE_AUTH_DOMAIN
ARG VITE_FIREBASE_PROJECT_ID
ARG VITE_FIREBASE_APP_ID
ARG VITE_DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh
ARG VITE_GOOGLE_MAPS_API_KEY
ARG VITE_HELP_URL

RUN npm run build

FROM nginx:1.28-alpine AS runner
COPY --from=builder /app/dist /usr/share/nginx/html
EXPOSE 80 443
